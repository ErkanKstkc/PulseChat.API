@baseUrl = http://localhost:5000

### 1. Register (Kayıt Ol)
# @name registerRequest
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "testuser@pulsechat.com",
  "username": "testuser",
  "password": "P@ssword123!"
}

### 2. Login (Giriş Yap)
# @name loginRequest
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "emailOrUsername": "testuser",
  "password": "P@ssword123!"
}

### Token Değişkeni (Login isteğinden sonra otomatik yakalanır veya buraya yapıştırılır)
@token = {{loginRequest.response.body.data.accessToken}}
@refreshToken = {{loginRequest.response.body.data.refreshToken}}

### 3. Refresh Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 4. Get Me (Kendi Profilim)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### 5. Create Room (Oda Oluştur)
# @name createRoomRequest
POST {{baseUrl}}/api/chat/rooms
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": 1,
  "title": "Backend Ekibi",
  "avatarUrl": null,
  "memberIds": [
    "00000000-0000-0000-0000-000000000000"
  ]
}

@roomId = {{createRoomRequest.response.body.data.id}}

### 6. Get User Rooms (Odalarım)
GET {{baseUrl}}/api/chat/rooms
Authorization: Bearer {{token}}

### 7. Get Room Messages (Geçmiş Mesajlar)
GET {{baseUrl}}/api/chat/rooms/{{roomId}}/messages?limit=50
Authorization: Bearer {{token}}

### 8. Send Friend Request (Arkadaş Ekle)
POST {{baseUrl}}/api/friendship/request
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "targetUsername": "ahmet"
}

### 9. Get Friends (Arkadaşlarım)
GET {{baseUrl}}/api/friendship
Authorization: Bearer {{token}}
