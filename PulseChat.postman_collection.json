							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/media/upload",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"media",
								"upload"
							]
						},
						"description": "MinIO S3 kovanına avatar veya sohbet eki dosyası yükler (Maks 25MB). Yüklenen dosyanın URL yolunu döner."
					},
					"response": []
